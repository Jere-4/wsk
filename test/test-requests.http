### get cats
GET http://localhost:3000/api/v1/cats

### get cat by id
GET http://localhost:3000/api/v1/cats/9592

### post new cat with image
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Misu
--MyBoundary
Content-Disposition: form-data; name="weight"

6
--MyBoundary
Content-Disposition: form-data; name="owner"

3602
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2023-10-08
--MyBoundary
Content-Disposition: form-data; name="file"; filename="cat.jpg"
Content-Type: image/jpeg

< ./cat.jpg
--MyBoundary--

### modify existing cat
PUT http://localhost:3000/api/v1/cats/9594
Content-Type: application/json

{
  "cat_name": "Frank da CAT",
  "weight": 11,
  "owner": 3689,
  "filename": "dfjafpeajfnd",
  "birthdate": "2021-10-12"
}

### delete cat by id
DELETE http://localhost:3000/api/v1/cats/9590



### get users
GET http://localhost:3000/api/v1/users

### get user by id
GET http://localhost:3000/api/v1/users/3609

### post new user
POST http://localhost:3000/api/v1/users
Content-Type: application/json

{
  "user_id": 3609,
  "name": "John Doe",
  "username": "johndoe",
  "email": "john@metropolia.fi",
  "role": "user",
  "password": "password"
}

### modify existing user
PUT http://localhost:3000/api/v1/users/3820
Content-Type: application/json

{
    "user_id": 3820,
    "name": "Adam Smith",
    "username": "adamsmith",
    "email": "adam@metropolia.fi",
    "role": "user3",
    "password": "password3"
}

### delete user by id
DELETE http://localhost:3000/api/v1/users/3742
